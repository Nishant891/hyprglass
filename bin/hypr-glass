#!/usr/bin/env python3
"""Run a desktop component from any working directory."""
from pathlib import Path
import os
import sys

if sys.version_info < (3, 11):
    raise SystemExit('Hypr Glass needs Python 3.11 or newer. Upgrade Python with your distribution package manager.')

sys.dont_write_bytecode = True
os.environ['PYTHONDONTWRITEBYTECODE'] = '1'
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from hyprglass.__main__ import main

raise SystemExit(main())
