{
  "layer": "top",
  "position": "top",
  "height": 29,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "margin-bottom": 0,
  "spacing": 0,
  "modules-left": [
    "custom/assistant",
    "clock",
    "custom/date",
    "custom/lock"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "group/resources",
    "group/status",
    "custom/panel"
  ],
  "custom/date": {
    "exec": "python3 ~/.config/hypr/bin/hypr-glass date",
    "interval": 60,
    "tooltip": false,
    "on-click": "python3 ~/.config/hypr/bin/hypr-glass calendar"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "all-outputs": true,
    "format-icons": {
      "1": "A",
      "2": "B",
      "3": "C",
      "4": "D",
      "5": "E",
      "6": "F",
      "7": "G",
      "8": "H",
      "9": "I",
      "10": "J",
      "11": "K",
      "12": "L",
      "13": "M",
      "14": "N",
      "15": "O",
      "16": "P",
      "17": "Q",
      "18": "R",
      "19": "S",
      "20": "T",
      "21": "U",
      "22": "V",
      "23": "W",
      "24": "X",
      "25": "Y",
      "26": "Z"
    },
    "sort-by-number": true
  },
  "bluetooth": {
    "format": "\udb80\udcaf",
    "format-on": "\udb80\udcaf",
    "format-off": "\udb80\udcb2",
    "format-disabled": "\udb80\udcb2",
    "format-connected": "\udb80\udcb1",
    "tooltip": true,
    "tooltip-format": "Bluetooth on",
    "tooltip-format-off": "Bluetooth off",
    "tooltip-format-disabled": "Bluetooth blocked",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "~/.config/hypr/bin/hypr-glass bluetooth menu",
    "on-click-right": "~/.config/hypr/bin/hypr-glass bluetooth menu"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-icons": [
      "\udb82\udd1f",
      "\udb82\udd22",
      "\udb82\udd25",
      "\udb82\udd28"
    ],
    "format-ethernet": "\udb80\ude00",
    "format-linked": "\udb80\ude00",
    "format-disconnected": "\udb82\udd2d",
    "format-disabled": "\udb82\udd2e",
    "tooltip": true,
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid}  \u00b7  {signalStrength}%",
    "tooltip-format-ethernet": "Wired  \u00b7  {ifname}",
    "tooltip-format-disconnected": "Not connected",
    "on-click": "~/.config/hypr/bin/hypr-glass wifi menu",
    "on-click-right": "~/.config/hypr/bin/hypr-glass wifi menu"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "\udb80\udc84",
    "format-icons": [
      "\udb80\udc7a",
      "\udb80\udc7c",
      "\udb80\udc7e",
      "\udb80\udc80",
      "\udb80\udc82"
    ],
    "format-time": "\u00b7 {H}h {M}m",
    "tooltip": true,
    "tooltip-format": "{capacity}%  {time}"
  },
  "clock": {
    "format": "\udb82\udd54  {:%H:%M %p}",
    "tooltip": false
  },
  "custom/panel": {
    "format": "\udb80\udf5c",
    "tooltip": false,
    "on-click": "python3 ~/.config/hypr/bin/hypr-glass panel"
  },
  "custom/assistant": {
    "format": "\udb82\udee2",
    "tooltip": true,
    "tooltip-format": "Local AI",
    "on-click": "python3 ~/.config/hypr/bin/hypr-glass assistant"
  },
  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "network",
      "battery"
    ]
  },
  "group/resources": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "disk"
    ]
  },
  "cpu": {
    "interval": 3,
    "format": "<span font_family=\"JetBrainsMono Nerd Font Propo\" size=\"10.5pt\" foreground=\"#89b4fa\">\udb83\udee0</span> {usage}%",
    "tooltip": true
  },
  "memory": {
    "interval": 3,
    "format": "<span font_family=\"JetBrainsMono Nerd Font Propo\" size=\"10.5pt\" foreground=\"#f9e2af\">\udb80\udf5b</span> {percentage}%",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB"
  },
  "disk": {
    "interval": 30,
    "path": "/",
    "format": "<span font_family=\"JetBrainsMono Nerd Font Propo\" size=\"10.5pt\" foreground=\"#a6e3a1\">\udb80\udeca</span> {percentage_used}%",
    "tooltip": true,
    "tooltip-format": "Disk: {used} / {total}"
  },
  "custom/lock": {
    "format": "\udb80\udf3e",
    "tooltip": true,
    "tooltip-format": "Lock",
    "on-click": "hyprlock"
  }
}
