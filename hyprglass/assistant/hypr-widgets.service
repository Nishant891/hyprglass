[Unit]
Description=Hyprland assistant and calendar
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=local.hypr.DesktopWidgets
ExecStart=%h/.config/hypr/bin/hypr-glass widgets --daemon
Restart=on-failure
RestartSec=1
Environment=GSK_RENDERER=gl
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
